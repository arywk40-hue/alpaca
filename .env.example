# Dedicated hackathon paper-trading account only. Never commit real credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional judge-facing identifier; never put credentials or secrets here.
ALPACA_ACCOUNT_ID=
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data

# LLM used by the thesis agent. The risk gate remains deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Safety: keep false during setup. Set true only after verifying MCP tools and paper keys.
ALLOW_ORDER_EXECUTION=false
DRY_RUN=true
# Opt-in paper-only experiment. This keeps the production 70-point threshold unchanged.
EXPLORATION_MODE=false
EXPLORATION_SCORE_THRESHOLD=40
# Read-only shadow-evaluation assumptions; zero means no fee/slippage assumption.
SHADOW_FEE_PER_CONTRACT_USD=0
SHADOW_SLIPPAGE_PER_LEG_USD=0
MAX_OPEN_POSITIONS=3
MAX_CONTRACTS_PER_TRADE=1
RISK_FRACTION_PER_TRADE=0.005
MAX_TRADE_RISK_USD=500
MAX_BID_ASK_SPREAD_PCT=0.08
MAX_EXECUTION_QUOTE_AGE_SECONDS=60
MAX_PLAN_DEBIT_CHANGE_PCT=0.10
PLAN_APPROVAL_TTL_SECONDS=300
# Used only to derive IV/delta from observed option quotes when Alpaca omits Greeks.
QUOTE_DERIVED_RISK_FREE_RATE=0.04
MIN_DTE=14
MAX_DTE=28
UNDERLYING_UNIVERSE=SPY,QQQ,IWM
